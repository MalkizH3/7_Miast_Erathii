rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function roomData(id){ return get(/databases/$(database)/documents/erathiaRooms/$(id)).data; }
  function member(id){ return signedIn() && request.auth.uid in roomData(id).members; }
  function host(id){ return signedIn() && roomData(id).host == request.auth.uid; }
  function hostAfter(id){ return signedIn() && getAfter(/databases/$(database)/documents/erathiaRooms/$(id)).data.host == request.auth.uid; }
  function closedMember(id){
   return signedIn() && exists(/databases/$(database)/documents/erathiaClosures/$(id))
    && request.auth.uid in get(/databases/$(database)/documents/erathiaClosures/$(id)).data.memberUids;
  }
  function closing(id){
   return member(id)
    && !exists(/databases/$(database)/documents/erathiaClosures/$(id))
    && !existsAfter(/databases/$(database)/documents/erathiaRooms/$(id))
    && getAfter(/databases/$(database)/documents/erathiaClosures/$(id)).data.closedByUid == request.auth.uid;
  }
  match /erathiaRooms/{id} {
   allow get: if closedMember(id) || (signedIn() && (resource.data.status == 'lobby' || request.auth.uid in resource.data.members));
   allow list: if false;
   allow delete: if closing(id);
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['status','host','members','players','picked','pickedUids'])
    && !exists(/databases/$(database)/documents/erathiaClosures/$(id))
    && request.resource.data.status == 'lobby' && request.resource.data.host == request.auth.uid
    && request.resource.data.members == [request.auth.uid] && request.resource.data.players.size() == 1
    && request.resource.data.players[0].uid == request.auth.uid
    && request.resource.data.players[0].name is string && request.resource.data.players[0].name.size() <= 50
    && request.resource.data.picked == [] && request.resource.data.pickedUids == [];
   allow update: if signedIn() && (
    (resource.data.host == request.auth.uid && request.resource.data.host == resource.data.host
     && request.resource.data.members == resource.data.members
     && request.resource.data.status in ['lobby','playing','discard_choice','finished'])
    || (resource.data.status == 'lobby' && request.resource.data.status == 'lobby'
     && !(request.auth.uid in resource.data.members) && resource.data.members.size() < 7
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','players'])
     && request.resource.data.members == resource.data.members.concat([request.auth.uid])
     && request.resource.data.players.size() == resource.data.players.size() + 1
     && request.resource.data.players == resource.data.players.concat([request.resource.data.players[resource.data.players.size()]])
     && request.resource.data.players[resource.data.players.size()].keys().hasOnly(['uid','name'])
     && request.resource.data.players[resource.data.players.size()].uid == request.auth.uid
     && request.resource.data.players[resource.data.players.size()].name is string
     && request.resource.data.players[resource.data.players.size()].name.size() <= 50)
    || (resource.data.status == 'lobby' && request.auth.uid in resource.data.members
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','players','host','status','leaveIndex'])
     && request.resource.data.leaveIndex is int && request.resource.data.leaveIndex >= 0
     && request.resource.data.leaveIndex < resource.data.members.size()
     && resource.data.members[request.resource.data.leaveIndex] == request.auth.uid
     && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
     && request.resource.data.players == resource.data.players.removeAll([resource.data.players[request.resource.data.leaveIndex]])
     && request.resource.data.host == (request.resource.data.members.size() > 0 ? request.resource.data.members[0] : '')
     && request.resource.data.status == (request.resource.data.members.size() > 0 ? 'lobby' : 'closed'))
   );
   match /hands/{uid} {
    allow get: if request.auth.uid == uid && (closedMember(id) || member(id));
    allow list: if false;
    allow create, update: if hostAfter(id);
    allow delete: if closing(id) || hostAfter(id);
   }
   match /moves/{uid} {
    allow get: if (closedMember(id) && request.auth.uid == uid) || (member(id) && (request.auth.uid == uid || host(id)));
    allow list: if host(id);
    allow delete: if closing(id) || host(id);
    allow create, update: if member(id) && request.auth.uid == uid
     // A confirmed choice is immutable until the host consumes it.
     // Old turn documents may be replaced after reconnecting.
     && (!exists(/databases/$(database)/documents/erathiaRooms/$(id)/moves/$(uid))
      || resource.data.turn != roomData(id).turn)
     && request.resource.data.keys().hasOnly(['turn','kind','choice'])
     && request.resource.data.turn == roomData(id).turn
     && ((roomData(id).status == 'playing' && request.resource.data.kind == 'pick'
      && !(uid in roomData(id).pickedUids)
      && request.resource.data.choice.keys().hasOnly(['cardId','action','left','right'])
      && request.resource.data.choice.action in ['build','stage','discard']
      && request.resource.data.choice.cardId in get(/databases/$(database)/documents/erathiaRooms/$(id)/hands/$(uid)).data.cardIds
      && request.resource.data.choice.left is int && request.resource.data.choice.left >= 0
      && request.resource.data.choice.right is int && request.resource.data.choice.right >= 0)
     || (roomData(id).status == 'discard_choice' && request.resource.data.kind == 'discard_bonus'
      && roomData(id).members[roomData(id).pendingDiscard[0]] == uid
      && request.resource.data.choice.keys().hasOnly(['cardId'])
      && (request.resource.data.choice.cardId == null || request.resource.data.choice.cardId in get(/databases/$(database)/documents/erathiaRooms/$(id)/hands/$(uid)).data.bonusIds)));
   }
  }
  match /erathiaState/{id} {
   allow get: if host(id);
   allow list: if false;
   allow create, update: if hostAfter(id);
   allow delete: if closing(id) || hostAfter(id);
  }
  match /erathiaClosures/{id} {
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/erathiaClosures/$(id)) || request.auth.uid in resource.data.memberUids);
   allow list, update, delete: if false;
   allow create: if closing(id)
    && roomData(id).status in ['playing','discard_choice','finished']
    && request.resource.data.keys().hasOnly(['memberUids','closedByUid','closedByIndex','closedByName','closedAt'])
    && request.resource.data.memberUids == roomData(id).members
    && request.resource.data.closedByIndex is int && request.resource.data.closedByIndex >= 0
    && request.resource.data.closedByIndex < roomData(id).members.size()
    && roomData(id).members[request.resource.data.closedByIndex] == request.auth.uid
    && request.resource.data.closedByName == roomData(id).players[request.resource.data.closedByIndex].name
    && request.resource.data.closedAt == request.time;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
